@echo off
REM SPDX-License-Identifier: MIT
REM Author: Peter Kokosharov <peter.kokosharov@gmail.com>
REM AI models: claude-sonnet-5-5, claude-opus-5-5
REM ai-rex launcher (stored LF; the Windows zip build writes CRLF). Uses "py -3" if present, else "python".
setlocal
REM No trailing ";": an empty PYTHONPATH entry would put the current directory on sys.path.
set "AIREX_PP=%~dp0"
if defined PYTHONPATH set "AIREX_PP=%AIREX_PP%;%PYTHONPATH%"
set "PYTHONPATH=%AIREX_PP%"
set "AIREX_PP="
set "PY=python"
where py >nul 2>nul && set "PY=py -3"
%PY% -P -m runtime %*
exit /b %ERRORLEVEL%
