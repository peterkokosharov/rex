# Role policies for orchestrator
# Copy this file to policy.yaml and customize for your project
# Load with: Orchestrator(policy_file="policy.yaml")

roles:
  ORCHESTRATOR:
    model: "gemini/gemini-flash"
    model_class: "OPUS"
    max_steps: 60
    allowed_tools:
      - "fileops"
      - "bash"
      - "git"
      - "websearch"
      - "task"
    sandbox:
      network: "none"
      memory: "2G"
      cpus: "1.0"
      pids_limit: 100
      read_only_root: true
      read_write_mounts: []
      read_only_overlays: []
    permissions:
      allow:
        - "task:*"
        - "fileops:*"
        - "bash:*"
        - "git:*"
        - "websearch:*"
      deny:
        - "git:push"

  CODER:
    model: "nvidia/nvidia/nemotron-3.5-super-vl-120b-a12b"
    model_class: "SONNET"
    max_steps: 25
    allowed_tools:
      - "fileops"
      - "bash"
      - "git"
      - "websearch"
      - "render_diagram"
    sandbox:
      network: "bridge"
      memory: "2G"
      cpus: "2.0"
      pids_limit: 100
      read_only_root: true
      read_write_mounts: []
      read_only_overlays: []
    permissions:
      allow:
        - "fileops:*"
        - "bash:pytest *"
        - "bash:cargo test *"
        - "bash:go test *"
        - "bash:npm test *"
        - "git:commit"
        - "git:diff"
        - "git:status"
        - "git:log"
      deny:
        - "git:push"
        - "bash:rm -rf *"
        - "bash:sudo *"

  TESTER:
    model: "gemini/gemini-flash-lite"
    model_class: "HAIKU"
    max_steps: 15
    allowed_tools:
      - "fileops"
      - "bash"
      - "git"
    sandbox:
      network: "bridge"
      memory: "1G"
      cpus: "1.0"
      pids_limit: 100
      read_only_root: true
      read_write_mounts: []
      read_only_overlays: []
    permissions:
      allow:
        - "fileops:read"
        - "bash:pytest *"
        - "bash:npm test *"
        - "bash:go test *"
        - "bash:cargo test *"
        - "git:status"
        - "git:diff"
      deny:
        - "fileops:write"
        - "fileops:edit"
        - "git:commit"
        - "git:push"

  REVIEWER:
    model: "gemini/gemini-flash"
    model_class: "OPUS"
    max_steps: 20
    allowed_tools:
      - "fileops"
      - "bash"
      - "git"
      - "websearch"
    sandbox:
      network: "none"
      memory: "1G"
      cpus: "1.0"
      pids_limit: 100
      read_only_root: true
      read_write_mounts: []
      read_only_overlays: []
    permissions:
      allow:
        - "fileops:read"
        - "bash:grep *"
        - "bash:cat *"
        - "git:diff"
        - "git:log"
        - "git:status"
      deny:
        - "fileops:write"
        - "fileops:edit"
        - "bash:*"
        - "git:*"

  RESEARCHER:
    model: "gemini/gemini-flash"
    model_class: "ROUTER"
    max_steps: 30
    allowed_tools:
      - "fileops"
      - "bash"
      - "git"
      - "websearch"
      - "webfetch"
    sandbox:
      network: "bridge"
      memory: "1G"
      cpus: "1.0"
      pids_limit: 100
      read_only_root: true
      read_write_mounts: []
      read_only_overlays: []
    permissions:
      allow:
        - "fileops:*"
        - "websearch:*"
        - "webfetch:*"
        - "git:status"
        - "git:log"
      deny:
        - "fileops:write"
        - "bash:*"
        - "git:commit"
        - "git:push"

  DEBUGGER:
    model: "nvidia/nvidia/nemotron-3.5-super-vl-120b-a12b"
    model_class: "EYES"
    max_steps: 25
    allowed_tools:
      - "fileops"
      - "bash"
      - "git"
      - "websearch"
      - "render_diagram"
    sandbox:
      network: "bridge"
      memory: "2G"
      cpus: "2.0"
      pids_limit: 100
      read_only_root: true
      read_write_mounts: []
      read_only_overlays: []
    permissions:
      allow:
        - "fileops:*"
        - "bash:*"
        - "git:*"
        - "websearch:*"
        - "render_diagram:*"
      deny:
        - "git:push"

# Global task spawn limits
task_spawn:
  max_depth: 3
  max_concurrent: 5
  max_total_per_session: 20

# Rate limiting (optional, requires Redis)
litellm_rate_limit:
  redis_url: "redis://localhost:6379/0"
  requests_per_minute: 60
  tokens_per_minute: 100000
  max_concurrent: 3